---
import Tecnos_icons from "./Tecnos_icons.astro";
import Tecno_icon from '../icons/Titulos/Tecno_icon.astro';
import Html from '../icons/Tecnologias/Stack/Html.astro';
import Css from '../icons/Tecnologias/Stack/Css.astro';
import Js from '../icons/Tecnologias/Stack/Js.astro';
import Java from '../icons/Tecnologias/Stack/Java.astro';
import Spring from '../icons/Tecnologias/Stack/SpringBoot.astro';
import Jwt from '../icons/Tecnologias/Stack/Jwt.astro';
import Mysql from '../icons/Tecnologias/Stack/Mysql.astro';
import Git from '../icons/Tecnologias/Herramientas/Git.astro';
import GitHub from '../icons/Tecnologias/Herramientas/GitHub.astro';
import GitLab from '../icons/Tecnologias/Herramientas/GitLab.astro';
import Maven from '../icons/Tecnologias/Herramientas/Maven.astro';
import Docker from '../icons/Tecnologias/Herramientas/Docker.astro';
import CiCd from '../icons/Tecnologias/Herramientas/CiCd.astro';
import Kubernetes from '../icons/Tecnologias/Herramientas/Kubernetes.astro';
import Linux from '../icons/Tecnologias/Herramientas/Linux.astro';

const stack = [
  { title: "Java", icon: Java },
  { title: "Spring Boot", icon: Spring },
  { title: "JWT", icon: Jwt },
  { title: "MySQL", icon: Mysql },
  { title: "HTML", icon: Html },
  { title: "CSS", icon: Css },
  { title: "JavaScript", icon: Js },
];

const tools = [
  { title: "Linux", icon: Linux },
  { title: "Maven", icon: Maven },
  { title: "Docker", icon: Docker },
  { title: "CI/CD", icon: CiCd },
  { title: "Kubernetes", icon: Kubernetes },
  { title: "Git", icon: Git },
  { title: "GitHub", icon: GitHub },
  { title: "GitLab", icon: GitLab },
];
---

<div class="flex flex-col items-center">
  <h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4">
    <Tecno_icon class="w-12 h-12"/>
      Tecnologías
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 p-4">
    <div>
      <h3 class="text-2xl opacity-80 mb-6 text-center">Stack Tecnológico</h3>
      <nav class="flex flex-wrap justify-center items-center gap-4">
        {stack.map(({ title, icon: Icon }) => (
          <Tecnos_icons title={title}>
            <Icon class="w-12 h-12 object-contain"/>
          </Tecnos_icons>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="text-2xl opacity-80 mb-6 text-center">Herramientas</h3>
      <nav class="flex flex-wrap justify-center gap-4">
        {tools.map(({ title, icon: Icon }) => (
          <Tecnos_icons title={title}>
            <Icon class="w-12 h-12 object-contain"/>
          </Tecnos_icons>
        ))}
      </nav>
    </div>
  </div>
</div>
