---
import Tecnos_icons from "./Tecnos_icons.astro";
import Tecno_icon from '../icons/Titulos/Tecno_icon.astro';
import Html from '../icons/Tecnologias/Frontend/Html.astro';
import Css from '../icons/Tecnologias/Frontend/Css.astro';
import Js from '../icons/Tecnologias/Frontend/Js.astro';
import Java from '../icons/Tecnologias/Backend/Java.astro';
import Spring from '../icons/Tecnologias/Backend/SpringBoot.astro';
import RestApis from '../icons/Tecnologias/Backend/RestApis.astro';
import SpringSecurity from '../icons/Tecnologias/Backend/SpringSecurity.astro';
import Jwt from '../icons/Tecnologias/Backend/Jwt.astro';
import JpaHibernate from '../icons/Tecnologias/Backend/JpaHibernate.astro';
import Mysql from '../icons/Tecnologias/BasedeDatos/Mysql.astro';
import Swagger from '../icons/Tecnologias/ControlandBuild/Swagger.astro';
import Git from '../icons/Tecnologias/ControlandBuild/Git.astro';
import GitHub from '../icons/Tecnologias/ControlandBuild/GitHub.astro';
import GitLab from '../icons/Tecnologias/ControlandBuild/GitLab.astro';
import Maven from '../icons/Tecnologias/ControlandBuild/Maven.astro';
import Docker from '../icons/Tecnologias/DevOps/Docker.astro';
import CiCd from '../icons/Tecnologias/DevOps/CiCd.astro';
import Kubernetes from '../icons/Tecnologias/DevOps/Kubernetes.astro';
import Linux from '../icons/Tecnologias/DevOps/Linux.astro';

const backend = [
  { title: "Java", icon: Java },
  { title: "Spring Boot", icon: Spring },
  { title: "REST APIs", icon: RestApis },
  { title: "Spring Security", icon: SpringSecurity },
  { title: "JWT", icon: Jwt },
  { title: "JPA/Hibernate", icon: JpaHibernate },
];

const frontend = [
  { title: "HTML", icon: Html },
  { title: "CSS", icon: Css },
  { title: "JavaScript", icon: Js },
];

const database = [
{ title: "MySQL", icon: Mysql },
];

const devops = [
  { title: "Linux", icon: Linux },
  { title: "Docker", icon: Docker },
  { title: "CI/CD", icon: CiCd },
  { title: "Kubernetes", icon: Kubernetes },
];

const controlAndBuild = [
  { title: "Maven", icon: Maven },
  { title: "Swagger/OpenAPI", icon: Swagger },
  { title: "Git", icon: Git },
  { title: "GitHub", icon: GitHub },
  { title: "GitLab", icon: GitLab },
];

---

<div class="flex flex-col items-center">
  <h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4">
    <Tecno_icon class="w-12 h-12"/>
      Tecnologías
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 p-4">
    <div>
      <h3 class="text-2xl opacity-80 mb-6 text-center">Backend</h3>
      <nav class="grid grid-cols-3 gap-4 place-items-center w-full">
        {backend.map(({ title, icon: Icon }) => (
          <Tecnos_icons title={title} size="md">
            <Icon/>
          </Tecnos_icons>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="text-2xl opacity-80 mb-6 text-center">Frontend</h3>
      <nav class="grid grid-cols-3 gap-4 place-items-center w-full">
        {frontend.map(({ title, icon: Icon }) => (
          <Tecnos_icons title={title} size="md">
            <Icon/>
          </Tecnos_icons>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="text-2xl opacity-80 mb-6 text-center">Base de Datos</h3>
      <nav class="grid grid-cols-3 gap-4 place-items-center w-full">
        {database.map(({ title, icon: Icon }) => (
          <Tecnos_icons title={title} size="md">
            <Icon/>
          </Tecnos_icons>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="text-2xl opacity-80 mb-6 text-center">DevOps / Infra</h3>
      <nav class="grid grid-cols-3 gap-4 place-items-center w-full">
        {devops.map(({ title, icon: Icon }) => (
          <Tecnos_icons title={title} size="md">
            <Icon/>
          </Tecnos_icons>
        ))}
      </nav>
    </div>

    <div>
      <h3 class="text-2xl opacity-80 mb-6 text-center">Control & Build</h3>
      <nav class="grid grid-cols-3 gap-4 place-items-center w-full">
        {controlAndBuild.map(({ title, icon: Icon }) => (
          <Tecnos_icons title={title} size="md">
            <Icon/>
          </Tecnos_icons>
        ))}
      </nav>
    </div>

  </div>
</div>
