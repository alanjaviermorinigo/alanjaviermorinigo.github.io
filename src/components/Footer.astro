---
import Linkedin from "../icons/Social/Linkedin.astro"
import Github from "../icons/Social/Github.astro"
import GmailSimple from "../icons/Social/GmailSimple.astro";
---

<footer class="opacity-80 m-4 mt-8 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center">
    <div class="rounded-lg w-full max-w-screen-xl mx-auto grid grid-cols-3 items-center py-4 text-sm">
  
      <a href="https://www.linkedin.com/in/alanjaviermorinigo/" target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-2 transition justify-self-start">
        <Linkedin class="size-4 md:size-6"/>
            LinkedIn
      </a>
      
      <a href="#" onclick="event.preventDefault();
        const email = 'alan'+'jmg0'+'@gmail.com';

        try {
        navigator.clipboard.writeText(email);
        } catch (e) {}
        const msg = this.querySelector('.copied-msg');
        msg.classList.remove('hidden');
        setTimeout(() => {
        msg.classList.add('hidden');}, 1500);"
        class="relative hover:underline flex items-center gap-2 transition justify-self-center">
      <GmailSimple class="size-5 md:size-6"/>
        Gmail
      <span
        class="copied-msg hidden absolute left-1/2 -translate-x-1/2 bottom-full mb-2
         md:left-full md:translate-x-0 md:bottom-auto md:top-1/2 md:-translate-y-1/2 md:ml-2
         text-xs text-green-500 whitespace-nowrap pointer-events-none
         transition-all duration-200 ease-out">
        ✔ Copiado
      </span>
      </a>
  
      <a href="https://github.com/alanjaviermorinigo/" target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-2 transition justify-self-end">
        <Github class="size-4 md:size-6"/>
            GitHub
      </a>
    </div>
  </footer>
