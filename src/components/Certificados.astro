---
import Social_icons from "../components/Social_icons.astro";
import LinkIcon from "../icons/Social/Link.astro";

const CERTIFICATES = [
  {
    title: "Site Reliability Operations",
    subtitle: "Curso de Ingeniero de fiabilidad SRO/DevOps.",
    description:
      "El curso de SRO/DevOps me permitió trabajar en equipo junto al área de QA Automation en prácticas profesionales, reforzando mis conocimientos en Linux, control de versiones con Git (GitHub y GitLab), contenedores con Docker, CI/CD Pipelines, Kubernetes y documentación técnica utilizando MkDocs.",
    image: "/assets/images/certificates/crowdar_logo.jfif",
    link: "/assets/images/certificates/Certificado_SRO_CrowdarAcademy_AlanJavierMorinigo.pdf",
    alt: "Logo CROWDAR ACADEMY",
  },
  {
    title: "SCRUM",
    subtitle: "Curso de la metodología ágil Scrum.",
    description:
      "El curso de SCRUM me proporcionó una base sólida en metodologías ágiles, permitiéndome organizar el trabajo en sprints, priorizar tareas mediante el backlog y colaborar de forma más efectiva dentro de un equipo de desarrollo.",
    image: "/assets/images/certificates/CertiProf_SCRUM.png",
    link: "/assets/images/certificates/Certificado_SCRUM_AlanJavierMorinigo.pdf",
    alt: "Logo CertiProf Scrum",
  },
];
---

<div class="container px-5 py-6 mx-auto">
  {CERTIFICATES.map((cert, index) => (
    <div
      class={`flex items-center lg:w-3/5 mx-auto border-b pb-10 mb-10 border-gray-800
        sm:flex-row flex-col gap-6
        ${index % 2 === 1 ? "sm:flex-row-reverse" : "sm:flex-row"}`}
    >
      <img
        src={cert.image}
        alt={cert.alt}
        class="w-32 sm:w-40 md:w-48 h-auto object-contain rounded-full"
      />

      <div class="flex-grow sm:text-left text-center mt-6 sm:mt-0">
        <h2 class="text-white text-2xl mb-2 font-bold">{cert.title}</h2>
        <p class="text-xl mb-2 font-semibold">{cert.subtitle}</p>
        <p class="leading-relaxed text-base">{cert.description}</p>

        <footer class="flex items-end justify-start mt-4 gap-x-4">
          <Social_icons href={cert.link}>
            <LinkIcon class="size-6" />
            Ver certificado
          </Social_icons>
        </footer>
      </div>
    </div>
  ))}
</div>