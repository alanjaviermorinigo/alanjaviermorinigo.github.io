---
import Java from "../icons/Tecnologias/Stack/Java.astro";
import SpringBoot from "../icons/Tecnologias/Stack/SpringBoot.astro";
import SpringSecurity from "../icons/Tecnologias/Stack/SpringSecurity.astro";
import JpaHibernate from "../icons/Tecnologias/Stack/JpaHibernate.astro";
import Mysql from "../icons/Tecnologias/Stack/Mysql.astro";
import Social_icons from "./Social_icons.astro";
import Tecnos_icons from "./Tecnos_icons.astro";
import Github from "../icons/Social/Github.astro";
import Link from "../icons/Social/Link.astro";

const TAGS = {
  Java: {
    name: "Java",
    icon: Java,
  },
  SpringBoot: {
    name: "Spring Boot",
    icon: SpringBoot,
  },
  SpringSecurity: {
    name: "Spring Security",
    icon: SpringSecurity,
  },
  JpaHibernate: {
    name: "JPA/Hibernate",
    icon: JpaHibernate,
  },
  Mysql: {
    name: "MySQL",
    icon: Mysql,
  },
};

const PROJECTS = [
  {
    title: "Proyecto en construcción.",
    description: "Proyecto en construcción... Proyecto en construcción... Proyecto en construcción... Proyecto en construcción...",
    link: "#",
    github: "https://github.com/alanjaviermorinigo/",
    image: "/assets/images/projects/Fondo_Black_1920x1080.jpg",
    tags: [TAGS.Java, TAGS.SpringBoot, TAGS.SpringSecurity, TAGS.JpaHibernate, TAGS.Mysql],
  },
  {
    title: "Proyecto en construcción.",
    description: "Proyecto en construcción... Proyecto en construcción... Proyecto en construcción... Proyecto en construcción...",
    link: "#",
    github: "https://github.com/alanjaviermorinigo/",
    image: "/assets/images/projects/Fondo_Black_1920x1080.jpg",
    tags: [TAGS.Java, TAGS.SpringBoot, TAGS.SpringSecurity, TAGS.JpaHibernate, TAGS.Mysql],
  },
];
---

<div class="flex flex-col gap-y-16">
  {PROJECTS.map(({ image, title, description, tags, link, github }, index) => (
    <article class={`flex flex-col md:gap-8 space-y-8 md:space-y-0 ${index % 2 === 1 ? "md:flex-row-reverse" : "md:flex-row"}`}>
      <div class="w-full md:w-1/2 flex items-center group">
        <div class="relative flex flex-col items-center transition duration-500 ease-in-out transform shadow-xl overflow-hidden rounded-xl sm:rounded-xl lg:border lg:border-gray-800 group-hover:shadow-2xl">
          <img alt="Captura del Proyecto" class="object-cover object-top w-full h-full transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105" loading="lazy" src={image} />
        </div>
      </div>

      <div class="w-full md:w-1/2 flex flex-col justify-center">
        <h3 class="text-2xl font-bold mb-2">{title}</h3>
        <div class="mt-2">
          <ul class="grid grid-cols-3 md:grid-cols-4 gap-4">
            {tags.map((tag) => (
              <li class="flex justify-center">
                <Tecnos_icons title={tag.name} size="sm" fixedTextHeight>
                  <tag.icon/>
                </Tecnos_icons>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-2 text-lg mb-4">{description}</div>

        <footer class="flex items-end justify-start mt-4 gap-x-4">
          {github && (
            <Social_icons href={github}>
              <Github class="size-5 md:size-6"/>
              Ver Repo
            </Social_icons>
          )}
          {link && (
            <Social_icons href={link}>
              <Link class="size-5 md:size-6"/>
              Ver Proyecto
            </Social_icons>
          )}
        </footer>
      </div>
    </article>
  ))}
</div>
