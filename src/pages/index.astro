---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import Linkedin from '../icons/Social/Linkedin.astro'
import Github from '../icons/Social/Github.astro'
import Social_icons from '../components/Social_icons.astro'
import Gmail from '../icons/Social/Gmail.astro'
import Section from '../components/Section.astro';
import Section_tecno from '../components/Section_tecno.astro';
import Tecnologias from '../components/Tecnologias.astro';
import Code from '../icons/Titulos/Code.astro'
import Proyectos from '../components/Proyectos.astro'
import Certificados from '../components/Certificados.astro'
import Sobre_mi from '../components/Sobre_mi.astro'
import Cert_icon from '../icons/Titulos/Cert_icon.astro'
import Me_icons from '../icons/Titulos/Me_icon.astro'
import Section_sobremi from '../components/Section_sobremi.astro'
import Footer from '../components/Footer.astro'
import Section_certificados from '../components/Section_certificados.astro';
---

<Layout title="Alan Javier Morinigo"
description="Soy Backend Developer Java, trabajo en proyectos personales aplicando buenas prácticas, seguridad y código limpio.">
	<main class="px-4">
		<Section>
		<img class="block mx-auto mb-6 md:mb-8 lg:mb-12 rounded-full size-48" src="/assets/images/avatar/Avatar_Black_200x200.jpg"/>
		<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-5 pb-6 lg:pb-10">
			Hola, Soy Alan
			<a href="https://www.linkedin.com/in/alanjaviermorinigo/" target="_blank" rel="noopener"> <div class="flex justify-center items-center hover:scale-110 transition">
				<Badge> Open To Work </Badge>
			</div><a/></h1>
		<h2 class="text-xl lg:text-2xl opacity-80 text-pretty max-w-{700px}">
			<span class="text-blue-300">Backend Developer Java.</span> <br>Trabajo en proyectos personales aplicando buenas prácticas, seguridad y código limpio.
		</h2>
		<nav class="flex flex-wrap items-center gap-x-5 mt-6">
			<Social_icons href="https://www.linkedin.com/in/alanjaviermorinigo/">
				<Linkedin class="size-4 md:size-6"/>
				LinkedIn
			</Social_icons>
			<Social_icons href="https://github.com/alanjaviermorinigo/">
				<Github class="size-4 md:size-6"/>
				GitHub
			</Social_icons>
			<Social_icons href="#" onclick="event.preventDefault(); navigator.clipboard.writeText('alanjmg0@gmail.com'); const msg = document.getElementById('copied-msg'); msg.classList.remove('opacity-0'); setTimeout(() => msg.classList.add('opacity-0'), 1500);">
				<Gmail class="size-4 md:size-6"/>
				alanjmg0@gmail.com
			</Social_icons>
			<span id="copied-msg" class="ml-2 text-xs text-green-500 opacity-0 transition-opacity duration-300"> ✔ Copiado </span>
		</nav>
		</Section>
		<Section_tecno id="tecnologias">
			<Tecnologias/>
		</Section_tecno>
		<Section id="proyectos">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4"> <Code class="size-8 "/>Proyectos </h2>
			</div>
			<Proyectos/>
		</Section>
		<Section_certificados id="certificados">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4"> <Cert_icon class="size-8 "/>Certificados </h2>
			</div>
			<Certificados/>
		</Section_certificados>
		<Section_sobremi id="sobre_mi">
			<div class="flex justify-center">
				<h2 class="text-4xl font-semibold pb-10 flex gap-x-3 items-center text-center mb-4"> <Me_icons class="size-8 "/>Sobre mí </h2>
			</div>
			<Sobre_mi/>
		</Section_sobremi>
		<Footer/>
	</main>
	
</Layout>
